restoreButton.Font = Enum.Font.GothamBold
restoreButton.TextSize = 12
restoreButton.Parent = frame

Instance.new("UICorner", restoreButton).CornerRadius =
    UDim.new(0, 8)

-- Save and optimize selected visual properties
local function optimize()
    saved.GlobalShadows = Lighting.GlobalShadows
    Lighting.GlobalShadows = false

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam") then

            saved[obj] = obj.Enabled
            obj.Enabled = false

        elseif obj:IsA("BasePart") then
            saved[obj] = {
                Material = obj.Material,
                Reflectance = obj.Reflectance
            }

            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
        end
    end
end

-- Restore original properties
local function restore()
    Lighting.GlobalShadows =
        saved.GlobalShadows or originalGlobalShadows

    for obj, data in pairs(saved) do
        if typeof(obj) == "Instance" and obj.Parent then
            if typeof(data) == "boolean" then
                obj.Enabled = data

            elseif typeof(data) == "table" then
                obj.Material = data.Material
                obj.Reflectance = data.Reflectance
            end
        end
    end

    table.clear(saved)
end

button.MouseButton1Click:Connect(function()
    if not enabled then
        optimize()
        enabled = true

        button.Text = "FPS BOOST: ON"
        button.BackgroundColor3 =
            Color3.fromRGB(35, 145, 85)
    else
        restore()
        enabled = false

        button.Text = "FPS BOOST: OFF"
        button.BackgroundColor3 =
            Color3.fromRGB(85, 50, 140)
    end
end)

restoreButton.MouseButton1Click:Connect(function()
    restore()
    enabled = false

    button.Text = "FPS BOOST: OFF"
    button.BackgroundColor3 =
        Color3.fromRGB(85, 50, 140)
end)

-- Draggable window
local UIS = game:GetService("UserInputService")
local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
