title.TextSize = 16
title.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(0.85, 0, 0, 40)
button.Position = UDim2.new(0.075, 0, 0, 55)
button.BackgroundColor3 = Color3.fromRGB(85, 50, 140)
